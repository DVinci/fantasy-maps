{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fantasy Maps (VS Code Browser)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/serve.js",
      "env": { "OPEN_IN_VSCODE": "1" },
      "outputCapture": "std"
    },
    {
      "name": "Fantasy Maps (External Browser)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/serve.js",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Listening on port (\\d+)",
        "uriFormat": "http://localhost:%s"
      }
    }
  ]
}
