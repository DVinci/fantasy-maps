@rendermode InteractiveServer
@inject MapStateService MapState

<h2>Territories</h2>
<DemoBox SvgContent="@_svg" IsGenerating="@_busy" Error="@_error" TestId="section7">
    <Controls>
        <button data-testid="btn-show-territories" @onclick="ShowTerritories" disabled="@_busy">Show territories</button>
    </Controls>
</DemoBox>

@code {
    string _svg = string.Empty;
    string _error = string.Empty;
    bool _busy;
    HeightField? _h;

    async Task EnsureH()
    {
        if (_h != null) return;
        var mesh = await MapState.EnsureMeshAsync(256);
        var h = HeightPrimitives.Add(
            HeightPrimitives.Slope(mesh, [Rand.Normal() * 4, Rand.Normal() * 4]),
            HeightPrimitives.Cone(mesh, -0.5),
            HeightPrimitives.Mountains(mesh, 5));
        h = HeightPrimitives.Normalize(h);
        h = HeightPrimitives.Peaky(h);
        h = Erosion.SetSeaLevel(h, 0.5);
        _h = await Task.Run(() => Erosion.DoErosion(h, 0.1f));
        _h = Erosion.CleanCoast(_h, 1);
    }

    async Task ShowTerritories()
    {
        _error = string.Empty;
        _busy = true;
        StateHasChanged();
        try
        {
            await EnsureH();
            _svg = await Task.Run(() =>
            {
                var @params = new MapParams { Npts = 256, Ncities = 5, Nterrs = 3 };
                var render = new RenderState { H = _h!, Params = @params };
                CityPlacer.PlaceCities(render);
                MapRenderer.PrepareRender(render);
                return MapRenderer.DrawTerritories(render);
            });
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
