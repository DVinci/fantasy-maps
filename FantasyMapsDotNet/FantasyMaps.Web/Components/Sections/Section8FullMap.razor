@rendermode InteractiveServer

<h2>Full map</h2>
<div class="demo final-map" data-testid="section8">
    <div class="controls">
        <button class="primary" data-testid="btn-generate-map" @onclick="GenerateMap" disabled="@_busy">Generate map</button>
    </div>
    @if (!string.IsNullOrEmpty(_error))
    {
        <div data-testid="section8-error" style="color:red;padding:8px;border:1px solid red;margin-top:8px;font-family:monospace;font-size:0.85em">
            Error: @_error
        </div>
    }
    @if (_busy)
    {
        <div class="loading-overlay">Generating map...</div>
    }
    <div data-testid="section8-svg">
        <SvgViewer Content="@_svg" />
    </div>
</div>

@code {
    string _svg = string.Empty;
    string _error = string.Empty;
    bool _busy;

    async Task GenerateMap()
    {
        _error = string.Empty;
        _busy = true;
        StateHasChanged();
        try
        {
            var @params = new MapParams { Npts = 512, Ncities = 10, Nterrs = 5 };
            _svg = await Task.Run(() =>
            {
                var mesh = MeshBuilder.GenerateGoodMesh(@params.Npts);
                var render = MapRenderer.GenerateFullMap(@params, mesh);
                var lang = FantasyMaps.Core.Language.LanguageFactory.MakeRandomLanguage();
                return MapRenderer.DrawMap(render, lang);
            });
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
