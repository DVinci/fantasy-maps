@rendermode InteractiveServer
@inject MapStateService MapState

<h2>Erosion</h2>
<DemoBox SvgContent="@_svg" IsGenerating="@_busy" Error="@_error" TestId="section4">
    <Controls>
        <button data-testid="btn-gen-coast" @onclick="GenCoast" disabled="@_busy">Generate coast</button>
        <button data-testid="btn-erode" @onclick="DoErode" disabled="@_busy">Erode</button>
        <button data-testid="btn-clean-coast" @onclick="DoCleanCoast" disabled="@_busy">Clean coast</button>
    </Controls>
</DemoBox>

@code {
    string _svg = string.Empty;
    string _error = string.Empty;
    bool _busy;
    HeightField? _h;

    async Task BuildH()
    {
        var mesh = await MapState.EnsureMeshAsync(256);
        var h = HeightPrimitives.Add(
            HeightPrimitives.Slope(mesh, [Rand.Normal() * 4, Rand.Normal() * 4]),
            HeightPrimitives.Cone(mesh, -0.5),
            HeightPrimitives.Mountains(mesh, 5));
        h = HeightPrimitives.Normalize(h);
        h = HeightPrimitives.Peaky(h);
        _h = Erosion.SetSeaLevel(h, 0.5);
    }

    async Task Run(Func<Task> action)
    {
        _error = string.Empty;
        _busy = true;
        StateHasChanged();
        try { await action(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    Task GenCoast() => Run(async () =>
    {
        _h = null;
        await BuildH();
        _svg = TerrainRenderer.DrawVoronoi(_h!);
    });

    Task DoErode() => Run(async () =>
    {
        if (_h == null) await BuildH();
        _h = await Task.Run(() => Erosion.DoErosion(_h!, 0.1f));
        _svg = TerrainRenderer.DrawVoronoi(_h);
    });

    Task DoCleanCoast() => Run(async () =>
    {
        if (_h == null) await BuildH();
        _h = Erosion.CleanCoast(_h!, 1);
        _svg = TerrainRenderer.DrawVoronoi(_h);
    });
}
